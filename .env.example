AMIGO_ENV=production
AMIGO_PUBLIC_URL=https://amigo.tolstik.ru/amigo/
AMIGO_TIMEZONE=Europe/Moscow
AMIGO_WEB_BIND=127.0.0.1
AMIGO_WEB_PORT=18181

POSTGRES_DB=amigo
POSTGRES_USER=amigo
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL=postgresql+psycopg://amigo@db:5432/amigo

AMIGO_ENCRYPTION_KEY_FILE=/run/secrets/app_encryption_key
WITHINGS_CLIENT_ID_FILE=/run/secrets/withings_client_id
WITHINGS_CLIENT_SECRET_FILE=/run/secrets/withings_client_secret
WITHINGS_ACCESS_TOKEN_FILE=/run/secrets/withings_access_token
WITHINGS_REFRESH_TOKEN_FILE=/run/secrets/withings_refresh_token
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_CHAT_ID_FILE=/run/secrets/telegram_chat_id

AMIGO_SYNC_INTERVAL_SECONDS=300
AMIGO_NOTIFICATION_DEBOUNCE_SECONDS=120
AMIGO_WEEKLY_DIGEST_DAY=mon
AMIGO_WEEKLY_DIGEST_TIME=08:00
